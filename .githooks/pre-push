#!/bin/sh
# The app's full gate before every push, run here as CI runs it (CI plan Wave 2).
#
# Install once per clone: `npm run hooks:install` (git config core.hooksPath .githooks).
#
# What CI's jobs run (.github/workflows/ci.yml), in the same order: Lint, Typecheck,
# every architecture gate, the contract check, the tests with coverage and the
# press audit — all of them `npm run verify` — then the two checks the Architecture
# gates job runs beyond verify: `audit:dependencies` and the salvaged-client-data
# scan. The native bundle exports ("Native bundle export") stay CI-only. The first
# red gate refuses the push and is named below; nothing is pushed. A by-design red
# push — the deliberate-failure commit a CI proof needs — bypasses this hook with
#
#   git push --no-verify
#
# Push from a clone outside iCloud-synced folders: jest hangs on evicted files.
set -u

remote=${1:-origin}

# Nothing to gate when the push only deletes refs.
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case $local_sha in
    0000000000000000000000000000000000000000) ;;
    *) pushing=1 ;;
  esac
done
[ "$pushing" -eq 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: npm is not on PATH. Nothing was pushed to '$remote'."
  exit 1
fi
export CI=1

started=$(date +%s)
elapsed() { echo $(( $(date +%s) - $1 )); }

red() {
  echo
  echo "pre-push: REFUSED — the gate '$1' is red (exit $2) after $(elapsed "$started") s. Nothing was pushed to '$remote'."
  echo "pre-push: fix it and push again. For a by-design red push: git push --no-verify"
  exit 1
}

gate() {
  name=$1
  shift
  echo "pre-push: $name"
  t0=$(date +%s)
  "$@"
  status=$?
  [ "$status" -eq 0 ] || red "$name" "$status"
  echo "pre-push: $name — green in $(elapsed "$t0") s"
}

# ci.yml "No salvaged client data", step for step. The identifier pattern is read
# from ci.yml itself, so this file never names the identifiers (the scan would
# find them here) and the hook and CI can never search for different ones.
salvage_scan() {
  if git ls-files | grep -i '_salvage'; then
    echo "FAIL: a _salvage path is tracked in this repository."
    return 1
  fi
  pattern=$(sed -n "s/^ *if git grep -Iln -iE '\([^']*\)' -- \. .*/\1/p" .github/workflows/ci.yml)
  if [ -z "$pattern" ]; then
    echo "FAIL: the identifier pattern was not found in .github/workflows/ci.yml (the 'No salvaged client data' step)."
    return 1
  fi
  if git grep -Iln -iE "$pattern" -- . ':(exclude).github/workflows/*'; then
    echo "FAIL: a real client identifier appears in tracked content."
    return 1
  fi
  echo "No salvaged client data: PASS"
}

dirty=$(git status --porcelain | wc -l | tr -d ' ')
if [ "$dirty" -ne 0 ]; then
  echo "pre-push: note — $dirty uncommitted path(s); the gate judges the working tree, the push sends the commits."
fi

gate "verify (lint, typecheck, architecture gates, contracts, tests with coverage, presses, facts)" npm run verify
gate "audit:dependencies" npm run audit:dependencies
gate "No salvaged client data" salvage_scan

echo
echo "pre-push: every gate green in $(elapsed "$started") s — pushing to '$remote'."
