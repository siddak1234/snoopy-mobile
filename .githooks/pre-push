#!/bin/sh
# The app's pre-push gate, by change class (Round 21, change-aware gates).
#
# Install once per clone: `npm run hooks:install` (git config core.hooksPath .githooks).
#
# It runs `node scripts/change-class.mjs --run --worktree`: exit 0 pushes, exit
# 10 (a red gate, named above it) refuses the push, and any other exit (the
# classifier itself failed) runs the full set here: verify, audit:dependencies
# and the private-data scan (the workflow lint ran before). The classes and what
# each runs: README "Verification".
# Before either, the kit's private-data scanner reads the commits being pushed
# (node scripts/kit/private-data-scan.mjs --push), then the kit's workflow lint
# (node scripts/kit/workflow-lint.mjs --pre-push: zizmor, offline, over the
# .github/workflows/ of each commit the push names, each ref's tip, never the
# working tree; BUILD-PLAN
# 30.19.15, snoopy-backend; a few seconds a commit): a finding (exit 1) or an
# error (exit 2) refuses the push.
# A by-design red push — the deliberate-failure commit a CI proof needs —
# bypasses this hook with
#
#   git push --no-verify
#
# by the owner's hand only: in a Claude Code session .claude/hooks/guard.mjs
# refuses it.
#
# Push from a clone outside iCloud-synced folders: jest hangs on evicted files.
set -u

remote=${1:-origin}

# git's ref lines, read once: the workflow lint lints each ref's tip.
refs=$(cat)

# Nothing to gate when the push only deletes refs.
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case $local_sha in
    0000000000000000000000000000000000000000 | '') ;;
    *) pushing=1 ;;
  esac
done <<EOF
$refs
EOF
[ "$pushing" -eq 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: npm is not on PATH. Nothing was pushed to '$remote'."
  exit 1
fi
export CI=1

started=$(date +%s)
elapsed() { echo $(( $(date +%s) - $1 )); }

red() {
  echo
  echo "pre-push: REFUSED — the gate '$1' is red (exit $2) after $(elapsed "$started") s. Nothing was pushed to '$remote'."
  echo "pre-push: fix it and push again. For a by-design red push: git push --no-verify"
  exit 1
}

gate() {
  name=$1
  shift
  echo "pre-push: $name"
  t0=$(date +%s)
  "$@"
  status=$?
  [ "$status" -eq 0 ] || red "$name" "$status"
  echo "pre-push: $name — green in $(elapsed "$t0") s"
}

dirty=$(git status --porcelain | wc -l | tr -d ' ')
if [ "$dirty" -ne 0 ]; then
  echo "pre-push: note — $dirty uncommitted path(s); the gate judges the working tree, the push sends the commits."
fi

gate "No private data (the pushed commits)" node scripts/kit/private-data-scan.mjs --push
lint_pushed() { printf '%s\n' "$refs" | node scripts/kit/workflow-lint.mjs --pre-push; }
gate "Workflow lint" lint_pushed

echo "pre-push: the gate by change class (scripts/change-class.mjs)"
node scripts/change-class.mjs --run --worktree
status=$?
case $status in
  0) ;;
  10) red "the change class's set (named above)" "$status" ;;
  *)
    echo "pre-push: the classifier failed (exit $status); running the full set"
    gate "verify (lint, docs checks, typecheck, architecture gates, contracts, tests with coverage, presses, facts)" npm run verify
    gate "audit:dependencies" npm run audit:dependencies
    gate "No private data" node scripts/kit/private-data-scan.mjs --tree
    ;;
esac

echo
echo "pre-push: every gate green in $(elapsed "$started") s — pushing to '$remote'."
