#!/bin/sh
# The app's pre-push gate, by change class (Round 21, change-aware gates).
#
# Install once per clone: `npm run hooks:install` (git config core.hooksPath .githooks).
#
# `node scripts/change-class.mjs --run --worktree` classifies the change against
# the merge base with origin/main (the working tree included), prints the class,
# the commands and what it skips, then runs them; the first red one refuses the
# push and is named below (exit 10). The classes (the classifier's header):
# docs (Markdown only: the docs checks and the records tests), code (the fast
# checks, every static audit, the contract check, the salvaged-client-data scan
# and jest's related tests; audit:presses needs the whole suite and is CI's) and
# full — today's whole gate: `npm run verify`, `audit:dependencies` and the
# salvage scan — for any dependency, contract, kit, CI, hook, tooling or script
# change, a deleted or renamed source file, an unrecognised path, or a
# classifier error. A classifier that fails (any exit but 0 or 10) runs the
# full set here. CI (.github/workflows/ci.yml) still runs everything on every
# pull request; the native bundle exports stay CI-only. A by-design red
# push — the deliberate-failure commit a CI proof needs — bypasses this hook with
#
#   git push --no-verify
#
# by the owner's hand only: in a Claude Code session .claude/hooks/guard.mjs
# refuses it.
#
# Push from a clone outside iCloud-synced folders: jest hangs on evicted files.
set -u

remote=${1:-origin}

# Nothing to gate when the push only deletes refs.
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case $local_sha in
    0000000000000000000000000000000000000000) ;;
    *) pushing=1 ;;
  esac
done
[ "$pushing" -eq 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: npm is not on PATH. Nothing was pushed to '$remote'."
  exit 1
fi
export CI=1

started=$(date +%s)
elapsed() { echo $(( $(date +%s) - $1 )); }

red() {
  echo
  echo "pre-push: REFUSED — the gate '$1' is red (exit $2) after $(elapsed "$started") s. Nothing was pushed to '$remote'."
  echo "pre-push: fix it and push again. For a by-design red push: git push --no-verify"
  exit 1
}

gate() {
  name=$1
  shift
  echo "pre-push: $name"
  t0=$(date +%s)
  "$@"
  status=$?
  [ "$status" -eq 0 ] || red "$name" "$status"
  echo "pre-push: $name — green in $(elapsed "$t0") s"
}

dirty=$(git status --porcelain | wc -l | tr -d ' ')
if [ "$dirty" -ne 0 ]; then
  echo "pre-push: note — $dirty uncommitted path(s); the gate judges the working tree, the push sends the commits."
fi

echo "pre-push: the gate by change class (scripts/change-class.mjs)"
node scripts/change-class.mjs --run --worktree
status=$?
case $status in
  0) ;;
  10) red "the change class's set (named above)" "$status" ;;
  *)
    echo "pre-push: the classifier failed (exit $status); running the full set"
    gate "verify (lint, docs checks, typecheck, architecture gates, contracts, tests with coverage, presses, facts)" npm run verify
    gate "audit:dependencies" npm run audit:dependencies
    gate "No salvaged client data" sh scripts/salvage-scan.sh
    ;;
esac

echo
echo "pre-push: every gate green in $(elapsed "$started") s — pushing to '$remote'."
