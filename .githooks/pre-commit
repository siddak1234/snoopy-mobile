#!/bin/sh
# The app's pre-commit gate: no private data in a commit of this public
# repository (the owner, 2026-11-15).
#
# Install once per clone: `npm run hooks:install` (git config core.hooksPath .githooks).
#
# It runs the kit's private-data scanner on what is staged
# (node scripts/kit/private-data-scan.mjs --staged): exit 0 commits, a finding
# (exit 1) or a scanner error (exit 2) refuses the commit. Tests and docs use
# reserved values only (CLAUDE.md, "Test data"). The same scanner reads the
# pushed commits in .githooks/pre-push and every tracked file in CI.
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on PATH. Nothing was committed."
  exit 1
fi

node scripts/kit/private-data-scan.mjs --staged
status=$?
case $status in
  0) exit 0 ;;
  1) echo "pre-commit: REFUSED — private data in the staged changes (named above). Nothing was committed." ;;
  *) echo "pre-commit: REFUSED — the private-data scanner failed (exit $status). Nothing was committed." ;;
esac
exit 1
