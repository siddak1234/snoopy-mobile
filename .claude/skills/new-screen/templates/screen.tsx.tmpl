 * sends, and how it says a refusal: DESIGN-CONTRACT.md. Its copy follows the
 * plain-words rule in app/CLAUDE.md; its words come from its view model.
 */
export default function __Pascal__Screen() {
  const router = useRouter();
  const insets = useSafeAreaInsets();
  const { palette } = useTheme();
  const view = __camel__View();
