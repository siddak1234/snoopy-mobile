{
  "name": "snoopy-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "jest",
    "test:coverage": "jest --ci --runInBand --coverage --coverageReporters=json --coverageDirectory=coverage --json --outputFile=coverage/jest-results.json",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "audit:credentials": "node scripts/audit-credentials.mjs",
    "audit:fixtures": "node scripts/audit-fixtures.mjs",
    "audit:platform": "node scripts/audit-platform.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=critical",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:spacing": "node scripts/audit-spacing.mjs",
    "audit:type": "node scripts/audit-type.mjs",
    "audit:vocabulary": "node scripts/audit-vocabulary.mjs",
    "audit:haptics": "node scripts/audit-haptics.mjs",
    "audit:presses": "node scripts/audit-presses.mjs",
    "generate:platform-contracts": "node scripts/generate-platform-contracts.mjs",
    "verify:platform-contracts": "node scripts/verify-platform-contracts.mjs",
    "release:ios": "bash scripts/release-ios.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "check:docs": "node scripts/kit/check-docs.mjs",
    "map": "node scripts/kit/map.mjs",
    "audit:docs": "node scripts/audit-doc-references.mjs",
    "verify": "npm run lint && npm run check:docs && npm run map -- --check && npm run audit:docs && npm run typecheck && npm run audit:credentials && npm run audit:tokens && npm run audit:type && npm run audit:spacing && npm run audit:vocabulary && npm run audit:haptics && npm run audit:fixtures && npm run audit:platform && npm run verify:platform-contracts && npm run test:coverage && node scripts/no-skipped-tests.mjs && npm run audit:presses && node scripts/repo-facts.mjs --gate verify"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "^55.0.0",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.18",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "openapi-fetch": "^0.17.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@redocly/openapi-core": "1.34.20",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "openapi-typescript": "7.13.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "jest-expo",
        "clearMocks": true,
        "setupFiles": [
          "<rootDir>/test/jest-setup.js"
        ],
        "moduleNameMapper": {
          "^expo-router$": "<rootDir>/test/mocks/expo-router.tsx",
          "^@/(.*)$": "<rootDir>/$1"
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|phosphor-react-native))",
          "/node_modules/react-native-reanimated/plugin/"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/test/jest-after-env.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/__tests__/real-router/",
          "/scripts/kit/"
        ]
      },
      {
        "displayName": "real-router",
        "preset": "jest-expo",
        "clearMocks": true,
        "setupFiles": [
          "<rootDir>/test/jest-setup.js"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|phosphor-react-native))",
          "/node_modules/react-native-reanimated/plugin/"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/test/jest-after-env.js",
          "<rootDir>/test/real-router-setup.ts"
        ],
        "testMatch": [
          "<rootDir>/__tests__/real-router/**/*.test.tsx"
        ]
      }
    ],
    "collectCoverageFrom": [
      "app/**/*.tsx",
      "components/**/*.tsx",
      "constants/**/*.ts",
      "hooks/**/*.tsx",
      "lib/**/*.ts",
      "!app/**/_layout.tsx"
    ]
  }
}
